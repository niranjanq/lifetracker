# Frontend configuration — copy to .env (project root)
#
# The Vite dev server proxies every /api request to this target so cookies and
# CSRF stay same-origin in the browser (see vite.config.ts). Point it at your
# running backend. With docker-compose the backend is reachable at http://backend:8000.

VITE_API_PROXY=http://localhost:8000

# --- Firebase Authentication (browser SDK) --------------------------------
# These are PUBLIC web-app config values (safe to expose in the frontend bundle,
# as Firebase requires). Copy the exact strings from Firebase Console → Project
# settings → General → Your apps → SDK setup and configuration.
# The real secret (the service-account JSON used to VERIFY tokens) stays on the
# backend via FIREBASE_CREDENTIALS_PATH / GOOGLE_APPLICATION_CREDENTIALS and is
# never placed here or committed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=lifetracker-0703.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lifetracker-0703
VITE_FIREBASE_APP_ID=
