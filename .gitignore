# ---------- Node / frontend ----------
node_modules/
dist/
dist-ssr/
*.local
.vite/
stats.html

# npm/yarn/pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Python / backend ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
*.manifest
*.spec

# Virtual environments (backend/venv, root .venv, etc.)
.venv/
venv/
env/
ENV/

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/

# ---------- Local databases (SQLite dev data — never commit) ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- Local env / secrets ----------
# ".env" matches at any depth (root and backend/.env); keep the examples tracked
.env
.env.local
.env.*.local
*.env.bak

# Firebase service-account credentials — NEVER commit (used only by the backend
# to verify ID tokens). The public VITE_FIREBASE_* web config lives in .env.
serviceAccount*.json
firebase-service-account*.json
google-services*.json
credentials*.json
secrets/
*.pem
*.key

# ---------- Logs / runtime artifacts ----------
*.log
uvicorn.out.log
uvicorn.err.log

# ---------- Editor / OS ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- Docker / Mailpit local data (if bind-mounted locally) ----------
mailpit-data/
pgdata/
# Firebase Admin credentials
firebase-admin-key.json
*service-account*.json
