# Backend configuration — copy to backend/.env
# These defaults are for LOCAL DEVELOPMENT only. In production (ENV=production)
# the app refuses to start unless every value below the banner is secure.

ENV=dev
SECRET_KEY=change-me-in-production

# --- Database -------------------------------------------------------------
# Local dev default: a file-based SQLite DB (no Docker needed). Migrations are
# applied automatically on startup in dev. docker-compose overrides this with
# DATABASE_URL to the PostgreSQL service. To run against Postgres manually:
#   DATABASE_URL=postgresql+psycopg://plt:plt@db:5432/life_tracker
DATABASE_URL=sqlite:///./dev.db

# --- Cookies / session ----------------------------------------------------
# Secure (HTTPS-only) cookies MUST be true in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=plt_sid
CSRF_COOKIE_NAME=plt_csrf
SESSION_TTL_SECONDS=604800

# Escape hatch to sign a LEGACY DB-password account in before its email is
# verified. It ONLY affects the legacy /login path; Firebase sign-in is always
# gated server-side. Keep this FALSE so unverified accounts can never obtain a
# session. Set true ONLY for a momentary local test, then revert.
ALLOW_LOGIN_UNVERIFIED=false

# --- CORS / origin --------------------------------------------------------
# The exact origin of the frontend. MUST be https:// in production.
FRONTEND_ORIGIN=http://localhost:5173

# --- Tokens ---------------------------------------------------------------
EMAIL_TOKEN_TTL_SECONDS=86400
RESET_TOKEN_TTL_SECONDS=1800

# --- Email delivery -------------------------------------------------------
# EMAIL_PROVIDER selects how verification/reset mail is sent:
#   mailpit  -> local SMTP catcher (Docker; UI at http://localhost:8025). This
#               NEVER reaches a real inbox - messages are only viewable in Mailpit.
#   smtp     -> a real SMTP relay (self-hosted / provider) in production.
#   resend   -> Resend HTTPS API (free tier), real inboxes. Requires RESEND_API_KEY.
# In production the app refuses to start while provider is mailpit.
EMAIL_PROVIDER=mailpit
# Canonical sender shown to recipients, for every provider.
# NOTE: while EMAIL_PROVIDER=mailpit this is display-only (Mailpit never
# delivers to a real inbox). Replace with a domain you actually own before
# switching to resend/smtp.
EMAIL_FROM=Personal Life Tracker <no-reply@lifetracker.app>
# Server-side secret only. Never expose in the frontend bundle. Required when
# EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# SMTP transport (used when EMAIL_PROVIDER=mailpit or smtp):
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- Rate limiting --------------------------------------------------------
RATELIMIT_ENABLED=true

# --- Firebase Authentication (identity provider) --------------------------
# The browser obtains a Firebase ID token (email/password + Google); the backend
# verifies it here with the Admin SDK and mints its own session. FIREBASE_PROJECT_ID
# is REQUIRED to enable token verification (and enforced in production).
#
# Credentials — pick ONE approved method; the private key is OPTIONAL:
#   1) Service-account file: FIREBASE_CREDENTIALS_PATH=/abs/path/serviceAccount.json
#      (Console -> Project settings -> Service accounts -> keys). Gitignored; NEVER
#      commit it.
#   2) Application Default Credentials (ADC): leave FIREBASE_CREDENTIALS_PATH empty
#      and provide ADC via GOOGLE_APPLICATION_CREDENTIALS, `gcloud auth
#      application-default login`, Workload Identity, or service-account
#      impersonation. Use this when Google Cloud policy forbids downloadable keys.
# The Admin SDK uses the same ADC chain, so no private key is ever required here.
# See the Firebase section in README.md.
FIREBASE_PROJECT_ID=lifetracker-0703
FIREBASE_CREDENTIALS_PATH=

# --- Read-only assistant (chatbot) ----------------------------------------
# OPTIONAL. The assistant is disabled until ALL THREE below are set. When unset,
# /api/chat/status reports configured=false and the chat API returns an honest
# "not configured" turn (it never fabricates answers or uses fake data).
# Provider is inferred from LLM_BASE_URL; only these OpenAI-compatible hosts are
# recognised: Gemini (https://generativelanguage.googleapis.com/v1beta/openai/),
# OpenRouter (https://openrouter.ai/api/v1), xAI/Grok (https://api.x.ai/v1).
# LLM_API_KEY is a SERVER-SIDE secret: never exposed on any response, never
# logged, never shipped to the frontend.
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Generation / abuse controls (defaults shown; change only if needed).
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_OUTPUT_TOKENS=800
# LLM_TEMPERATURE=0
# CHAT_MAX_MESSAGE_CHARS=2000
# CHAT_DAILY_REQUEST_LIMIT=200
# CHAT_RETENTION_DAYS=90

# --- Dev startup ----------------------------------------------------------
# Apply alembic migrations automatically on boot (non-production only).
AUTO_MIGRATE=true
